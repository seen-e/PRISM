# LeRobot dataset as accepted by OpenPI (for example, org/dataset).
export PRISM_REPO_ID=org/dataset

# Produced by prism-compute-pps.
export PRISM_PPS_PATH=/path/to/pps_output/pps_weights.npy

# Number of real action dimensions before OpenPI's fixed-width zero padding.
export PRISM_LOSS_ACTION_DIM=14

# Optional: the default is the public gs:// OpenPI pi0.5 base checkpoint.
export PRISM_BASE_CHECKPOINT=/path/to/pi05_base/params

# Locations for normalization assets and training outputs.
export PRISM_ASSETS_DIR=/path/to/norm_stats_assets
export PRISM_CHECKPOINT_DIR=/path/to/output_checkpoints

export PRISM_BATCH_SIZE=192
export PRISM_NUM_WORKERS=0
export PRISM_NUM_TRAIN_STEPS=15000
export PRISM_PSW_GAMMA=2.0
export PRISM_PSW_TAU_0=1.0
export PRISM_PSW_P=2.0
export PRISM_CPR_LAMBDA=0.1

export EXP_NAME=prism_run
